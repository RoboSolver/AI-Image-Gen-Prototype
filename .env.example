# Pollinations API Key (get from https://enter.pollinations.ai)
# Server-to-Server Secret Key (starts with sk_)
POLLINATIONS_API_KEY=

# Stability AI API Key (get from https://platform.stability.ai)
# 25 free credits on signup, then pay-per-use
STABILITY_API_KEY=

# Flask settings
FLASK_SECRET_KEY=your-secret-key-here
FLASK_ENV=development
FLASK_PORT=5000

# Default generation settings
DEFAULT_PROVIDER=pollinations
DEFAULT_ASPECT_RATIO=1:1
DEFAULT_STYLE=realistic
DEFAULT_RESOLUTION=1024x1024
DEFAULT_NUM_IMAGES=1